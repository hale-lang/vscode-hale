{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hale",
  "scopeName": "source.hale",
  "fileTypes": [
    "hl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#numbers"
    },
    {
      "name": "entity.name.function.lifecycle.hale",
      "match": "\\b(birth|accept|release|run|drain|dissolve|on_failure|bulk|harmonic|resolution|on_full|on_overflow)(?=\\s*\\()"
    },
    {
      "match": "(?:^|(?<=[{;]))\\s*(params|contract|bus|capacity|placement|bindings|claims|mode|topology|schedule|birth_check|projection|roles|principals|captures|epoch|payload|subject|domain|edges|seed|origin|round)(?=\\s*(\\{|\\(|:|$))",
      "captures": {
        "1": {
          "name": "keyword.other.block.hale"
        }
      }
    },
    {
      "match": "(?:^|(?<=[{;]))\\s*(subscribe|publish|expose|consume|forbid|require|count|bound|cover|serve|listen|connect|restart|restart_in_place|quarantine|reorganize|reserve|tick|duration)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.statement.hale"
        }
      }
    },
    {
      "name": "support.function.placement.hale",
      "match": "\\b(cooperative|pinned|pool|core|cores|replicas|node|l3|heap|slot_count|unix|shm_ring|http|role|intra_process|intra_machine|cross_machine|zero_copy|reperspective)(?=\\s*(\\(|=|,|\\)))"
    },
    {
      "name": "keyword.other.policy.hale",
      "match": "(?<=\\bor\\s)(floor|ceil|trunc|half_even|half_up|clamp|wrap|raise|discard|block|drop|refuse|default|wait|sum|prod)\\b"
    },
    {
      "name": "keyword.control.hale",
      "match": "\\b(if|else|match|for|in|while|return|break|continue|yield|terminate|violate|fail|bubble|until|wait)\\b"
    },
    {
      "name": "storage.type.hale",
      "match": "\\b(locus|perspective|type|const|fn|module|interface|trait|impl|macro|topic|group|constitution|closure|ring_layout|api|rpc|unit|quantity|point|distinct|range)\\b"
    },
    {
      "name": "keyword.control.import.hale",
      "match": "\\b(import|export|as)\\b"
    },
    {
      "name": "storage.modifier.hale",
      "match": "\\b(let|mut|async|await|fallible|main|inline|explicit|approx|extends|adopt)\\b"
    },
    {
      "name": "variable.language.hale",
      "match": "\\b(self)\\b"
    },
    {
      "name": "keyword.operator.word.hale",
      "match": "\\b(or|where|with|via|during|avoiding|within|serves|requires|includes|ordered_by|keyed_by|persists_through|resets_on|resets_per_epoch|stable_when|serialize_as|as_parent_for|indexed_by)\\b"
    },
    {
      "name": "support.type.primitive.hale",
      "match": "\\b(Int|Uint|Float|Decimal|String|Bool|Time|Duration|Bytes|StringView|BytesView|Never|Unit)\\b"
    },
    {
      "name": "support.function.std.hale",
      "match": "\\bstd(::[a-z_][A-Za-z0-9_]*)+\\b"
    },
    {
      "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.hale"
        },
        "2": {
          "name": "entity.name.function.hale"
        }
      }
    },
    {
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(<-)",
      "captures": {
        "1": {
          "name": "entity.name.type.topic.hale"
        },
        "2": {
          "name": "keyword.operator.send.hale"
        }
      }
    },
    {
      "name": "entity.name.type.hale",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "entity.name.function.call.hale",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.hale",
      "match": "<-|->|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!]"
    },
    {
      "name": "punctuation.accessor.hale",
      "match": "::|\\."
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.hale",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.hale",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hale",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.hale",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hale",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.interpolation.hale",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.hale",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.other.time.hale",
          "match": "`\\d{4}-\\d{2}-\\d{2}T[^`]*`"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.tag.attribute.hale",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(0x[0-9A-Fa-f_]+)\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.hex.hale"
            }
          }
        },
        {
          "match": "\\b(\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)([A-Za-z_][A-Za-z0-9_]*)?\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.hale"
            },
            "2": {
              "name": "keyword.other.unit.hale"
            }
          }
        }
      ]
    }
  },
  "x-generated-from": "keywords.rs",
  "x-keyword-count": 172,
  "x-unclassified": []
}
